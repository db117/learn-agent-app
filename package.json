{
  "name": "desktop-learning-agent",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,web,tauri -c blue,green,magenta \"pnpm dev:backend\" \"pnpm dev:web\" \"pnpm dev:tauri\"",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "dev:tauri": "wait-on http://127.0.0.1:1420 && node scripts/tauri-dev.mjs",
    "build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cargo:check": "node scripts/cargo-check.mjs",
    "backend:test": "node scripts/maven.mjs test",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm cargo:check && pnpm backend:test",
    "native:build": "node scripts/maven.mjs -Pnative native:compile",
    "native:check": "node scripts/native-check.mjs",
    "package:desktop": "pnpm native:build && node scripts/prepare-sidecar.mjs && pnpm exec tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}
